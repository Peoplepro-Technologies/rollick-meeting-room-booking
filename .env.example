# Override any of the defaults from docker-compose.yml here.
# Copy this file to `.env` and edit as needed.

JWT_SECRET=please-change-this-to-a-long-random-string

# Comma-separated extra origins the API will allow CORS from in production.
# If you put the app behind a reverse proxy on another host:port, add it here
# (e.g. CORS_ALLOWED_ORIGINS=https://booking.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# If you proxy the app through a single public URL, set FRONTEND_URL too.
# FRONTEND_URL=https://booking.example.com
